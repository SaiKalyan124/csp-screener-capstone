# Create a Market Data API key in Alpaca, then copy this file to .env.
ALPACA_API_KEY=replace_me
ALPACA_SECRET_KEY=replace_me
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=csp-screener-capstone
TAVILY_API_KEY=

# Optional hosted persistence. Use the server-only service role key, never the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Keep false locally. Set true only in the hosted Vercel environment.
AUTH_REQUIRED=false
# Optional comma-separated hosted access allowlist. This grants app access only.
ALLOWED_EMAILS=
